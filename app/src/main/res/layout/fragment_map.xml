<?xml version="1.0" encoding="utf-8"?>
<!-- Peta kampus (FR-08, FR-09) sesuai wireframe Gambar 3f dan Laporan 1 Tabel 6: osmdroid + OpenStreetMap. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <org.osmdroid.views.MapView android:id="@+id/map" android:layout_width="match_parent"
        android:layout_height="match_parent" android:contentDescription="@string/map_title" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="top" android:orientation="vertical" android:padding="16dp">
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
            android:layout_height="wrap_content" app:contentPadding="8dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/map_title" android:textAppearance="@style/TextAppearance.PaduKampus.JudulKartu" />
                <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:hint="@string/map_search">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/search"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
                        android:inputType="textCapCharacters" android:importantForAutofill="no" />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite" android:textAppearance="@style/TextAppearance.PaduKampus.Keterangan" />
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/rooms" android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Kartu ruangan terpilih -->
    <com.google.android.material.card.MaterialCardView android:id="@+id/selected_card"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:layout_margin="16dp" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/selected_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.PaduKampus.JudulKartu" />
            <TextView android:id="@+id/selected_detail" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.PaduKampus.Isi" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton android:id="@+id/close_selected"
                    style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/map_close" />
                <com.google.android.material.button.MaterialButton android:id="@+id/center_selected"
                    style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/map_center" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
