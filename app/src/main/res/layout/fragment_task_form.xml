<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/task_form_title" android:textSize="22sp" android:layout_marginTop="8dp" android:textStyle="bold" android:accessibilityLiveRegion="polite" />
<com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/task_course"><com.google.android.material.textfield.TextInputEditText android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/course" android:minHeight="48dp" android:inputType="textCapWords" android:importantForAutofill="no" /></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/task_name"><com.google.android.material.textfield.TextInputEditText android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/title" android:minHeight="48dp" android:inputType="textCapSentences" android:importantForAutofill="no" /></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/task_description"><com.google.android.material.textfield.TextInputEditText android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/description" android:minHeight="48dp" android:inputType="textMultiLine" android:importantForAutofill="no" /></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/task_deadline"><com.google.android.material.textfield.TextInputEditText android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/deadline" android:minHeight="48dp" android:inputType="text" android:importantForAutofill="no" /></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/task_reminder"><com.google.android.material.textfield.TextInputEditText android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/reminder" android:minHeight="48dp" android:inputType="number" android:importantForAutofill="no" /></com.google.android.material.textfield.TextInputLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/task_source" android:textSize="16sp" android:layout_marginTop="8dp" android:accessibilityLiveRegion="polite" />
<Spinner android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/source" android:minHeight="48dp" android:contentDescription="@string/task_source" />
<com.google.android.material.button.MaterialButton android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/enable_notifications" android:minHeight="48dp" android:text="@string/task_notification_permission" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/notification_status" android:textSize="14sp" android:layout_marginTop="8dp" android:accessibilityLiveRegion="polite" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/status" android:textSize="14sp" android:layout_marginTop="8dp" android:accessibilityLiveRegion="polite" />
<com.google.android.material.button.MaterialButton android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/save" android:minHeight="48dp" android:text="@string/task_save" />
<com.google.android.material.button.MaterialButton android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/cancel" android:minHeight="48dp" android:text="@string/task_cancel" />
</LinearLayout>
</ScrollView>
