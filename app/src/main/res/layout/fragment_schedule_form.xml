<?xml version="1.0" encoding="utf-8"?>
<!-- Form Jadwal (FR-02): mata kuliah beserta jadwal mingguan (hari, jam, ruangan, dosen). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent"
    android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
        android:padding="16dp">
        <TextView android:id="@+id/form_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/schedule_form_title" android:textAppearance="@style/TextAppearance.PaduKampus.JudulLayar" />
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:hint="@string/schedule_course">
            <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/course" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="textCapWords" android:completionThreshold="1" android:importantForAutofill="no" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:hint="@string/schedule_code">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/code" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="textCapCharacters" android:importantForAutofill="no" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:hint="@string/schedule_lecturer_hint">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/lecturer" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="textCapWords" android:importantForAutofill="no" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:hint="@string/schedule_credits">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/credits" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="number" android:importantForAutofill="no" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:text="@string/schedule_day" android:textAppearance="@style/TextAppearance.PaduKampus.Keterangan" />
        <Spinner android:id="@+id/day" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:contentDescription="@string/schedule_day" />
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:hint="@string/schedule_start">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/start" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="time" android:importantForAutofill="no" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:hint="@string/schedule_end">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/end" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="time" android:importantForAutofill="no" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:text="@string/schedule_room" android:textAppearance="@style/TextAppearance.PaduKampus.Keterangan" />
        <Spinner android:id="@+id/room" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:contentDescription="@string/schedule_room" />
        <TextView android:id="@+id/room_hint" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.PaduKampus.Keterangan" />
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:hint="@string/schedule_reminder">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/reminder" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="number" android:importantForAutofill="no" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:accessibilityLiveRegion="polite" android:textColor="@color/pk_galat" android:textSize="14sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/cancel"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="8dp"
                android:minHeight="48dp" android:text="@string/form_cancel" />
            <com.google.android.material.button.MaterialButton android:id="@+id/save" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp" android:text="@string/form_save" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
